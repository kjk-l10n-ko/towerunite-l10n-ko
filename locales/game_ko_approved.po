msgctxt "::717003D64A2E84047C065EB21A6197D1"
msgid ""
"An adventure 65 million years in the making, ending in a monster golf "
"course."
msgstr "6500만 년에 걸쳐 완성된 모험, 그 끝에는 괴물 골프장이 있습니다."

#. Tower/Content/Maps/Info/MG_Emission_Info.uexp
msgctxt "::38FAE274432FBAC3BEEBBB825798D39B"
