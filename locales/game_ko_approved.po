msgid "Position in item direction"
msgstr "아이템 방향 기준 위치"

#. Tower/Content/UI/Items/Tools/ToolDeltaTransformer.uexp
msgctxt "::5FAF577544BA4D731B8A80945963AD6B"
msgid ""
"Makes the item move in the item's local directions, otherwise in the global "
"XYZ directions."
msgstr "아이템을 아이템의 로컬 방향으로 움직이며, 없으면 전역 XYZ 방향으로 움직입니다."

