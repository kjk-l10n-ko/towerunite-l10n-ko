msgid "Speed Racing"
msgstr "스피드 레이싱"

#. Tower/Content/UI/MainMenu/GameWorldMenus/AccelerateMenu.uexp
msgctxt "::1C51B49643B6089DA142738294E6021A"
msgid "Scenic Routes"
msgstr "경치 좋은 길"

