msgstr "!안녕하세에에에에에에에에에에에에에요오오!!"

#. Tower/Content/Manifests/DialogueManifest.uexp
msgctxt "::4296DE5647E8B297B19B7A80703FAEBC"
msgid "!HelloOoOoOoOoOoOo!"
msgstr "!안녕하세에에에에에에에에에에에요오오!"

#. Tower/Content/Manifests/DialogueManifest.uexp
msgctxt "::1709E05A4E540E7187CDE4886C297FD9"
msgid "Magic is my business!"
msgstr "마법이 내 사업이지!"

#. Tower/Content/Manifests/DialogueManifest.uexp
msgctxt "::8C1BA26E484EE0B2810E8E93636663D6"
msgid "I stole these!!"
msgstr "이거 훔친 거야!!"

#. Tower/Content/Manifests/DialogueManifest.uexp
msgctxt "::C91586554768BC36A8A1EEA8F3D14FCF"
msgid "You can find lots of things here!"
msgstr "여기서 많은 걸 찾을 수 있어요!"

#. Tower/Content/Manifests/DialogueManifest.uexp
msgctxt "::CC97029442544A31EB63CC9DC178D420"
msgid "I steal! @You don't! @It's how things work!"
msgstr "나 훔쳐! @넌 안 돼! @이게 규칙이야!"

#. Tower/Content/Manifests/DialogueManifest.uexp
msgctxt "::3A0035C94C994AE171F95CAAC99B52F1"
msgid "They may catch me, but I'm a ghost!"
msgstr "날 잡을 순 있어도, 난 유령이니까!"

#. Tower/Content/Manifests/DialogueManifest.uexp
msgctxt "::5806BC6B4D19B0E78D2D68965DF3FA9A"
msgid "Magic is whatever you want!"
msgstr "마법은 네가 원하는 그 무엇이든!"

#. Tower/Content/Manifests/DialogueManifest.uexp
msgctxt "::32EBD6CC4C37125DB1635FB43396AAF9"
msgid "The moon is... bad. @0/10!!!!"
msgstr "달은... 별로야. @0/10!!!!"

#. Tower/Content/Manifests/DialogueManifest.uexp
