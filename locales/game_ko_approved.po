msgctxt "::A5CDB9B648A14896E91295B77E971915"
msgid "BACK TO MENU"
msgstr "메뉴로"

#. Tower/Content/UI/MainMenu/GameWorldMenus/VirusMenu.uexp
msgctxt "::2F0C5C8349949BF6734EABB390F51D26"
msgid "VIRUS SERVERS"
msgstr "바이러스 서버"

#. Tower/Content/UI/MainMenu/GameWorldMenus/VirusMenu.uexp
msgctxt "::10A7E87342B0C2BA94FD9E8C88C2118D"
msgid "Survive"
msgstr "생존하라"

#. Tower/Content/UI/MainMenu/GameWorldMenus/VirusMenu.uexp
msgctxt "::61B14FE84FEF3B7F4CAB298A56B83114"
msgid ""
"An unknown, deadly virus has begun to spread! \r\n"
"Hold the infected back with your weapons until you can escape."
msgstr ""
"정체불명의 치명적인 바이러스가 퍼지기 시작했습니다! \r\n"
"탈출할 수 있을 때까지 무기로 감염자들을 막아내세요."

#. Tower/Content/UI/MainMenu/GameWorldMenus/VirusMenu.uexp
msgctxt "::BD26181D42F659C0C10BCDAF663F8C92"
msgid ""
"The survivors must use their makeshift arsenal to fight off the infected."
msgstr "생존자들은 임시 무기로 감염자들을 막아내야 합니다."

#. Tower/Content/UI/MainMenu/GameWorldMenus/VirusMenu.uexp
msgctxt "::A1EA76B744FBFD7A93D8B391138300D4"
msgid "First Person Shooter | 4-12 Players"
msgstr "1인칭 슈터 | 4-12명"

#. Tower/Content/UI/MainMenu/GameWorldMenus/VirusMenu.uexp
msgctxt "::9C13BAD04E507EC7614B0AB1456A8313"
msgid "Infect Everyone"
msgstr "모두 감염시켜라"

#. Tower/Content/UI/MainMenu/GameWorldMenus/VirusMenu.uexp
msgctxt "::1ADE69E5441C3EF0C2D5DA8ED8B03658"
msgid ""
"You're either a survivor, or you’re infected. There is no in between. The "
"infected are driven to join together and give the virus to survivors."
msgstr "당신은 생존자이거나 감염자입니다. 중간은 없습니다. 감염자들은 뭉쳐서 생존자들에게 바이러스를 옮기려 합니다."

#. Tower/Content/UI/MainMenu/GameWorldMenus/VirusMenu.uexp
msgctxt "::8C57CC514F9887E49D9348B98891CF77"
msgid "BACK TO MENU"
msgstr "메뉴로"

