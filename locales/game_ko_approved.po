#. Tower/Content/UI/Chat/ChatRules.uexp
msgctxt "::9890447E462C7740349CC2A9542632DE"
msgid "Official Game Rules"
msgstr "공식 게임 규칙"

#. Tower/Content/UI/Chat/ChatRules.uexp
msgctxt "::C9E1AA5B4C36CB18CC13318645BC0921"
msgid "No violating privacy of others or doxxing."
msgstr "타인의 사생활 침해나 신상 공개 금지."

#. Tower/Content/UI/Chat/ChatRules.uexp
msgctxt "::24FECDF54457A8397055EBB36926E568"
msgid "No politics or debates of controversial nature."
msgstr "정치나 논쟁적인 주제의 토론 금지."

#. Tower/Content/UI/Chat/ChatRules.uexp
msgctxt "::7727358A4BF87E2BB41693B9B902DB74"
msgid "No circumventing chat filters."
msgstr "채팅 필터 우회 금지."

#. Tower/Content/UI/Chat/ChatRules.uexp
msgctxt "::5A8C857F45B435F88D1B7398E2805D64"
msgid "No advertising or spam."
msgstr "광고나 스팸 금지."

#. Tower/Content/UI/Chat/ChatRules.uexp
msgctxt "::8C27513D435788DCBE1223985951D56C"
msgid ""
"\r\n"
"This chat is designed to connect with other players in the game and have a pleasant experience.\r\n"
"\r\n"
"If you see someone breaking the rules, please report them."
msgstr ""
"\r\n"
"이 채팅은 게임 속 다른 플레이어와 즐겁게 소통하기 위한 공간입니다.\r\n"
"\r\n"
"규칙을 어기는 사람이 있으면 신고해 주세요."

#. Tower/Content/UI/Chat/ChatRules.uexp
msgctxt "::AF23EB00417DC3FF845B0B9975BC46D0"
msgid "Respect others and treat them how you wish to be treated."
msgstr "다른 사람을 존중하고, 자신이 대우받고 싶은 방식으로 대하세요."

#. Tower/Content/UI/Chat/ChatRules.uexp
msgctxt "::76D6807C49EDAEE09022149677461F34"
msgid "Zero tolerance on discrimination, hate speech, or racism."
msgstr "차별, 혐오 발언, 인종차별은 용납되지 않습니다."

#. Tower/Content/UI/Chat/ChatRules.uexp
msgctxt "::587C98A544DE9B2B69162CA151DBF059"
msgid "No harrassment or trolling."
msgstr "괴롭힘이나 트롤링 금지."

#. Tower/Content/UI/Chat/ChatRules.uexp
msgctxt "::7237B8E646DB8349078784BDFCDC8F2F"
msgid "No impersonating admins or backseat moderation."
msgstr "관리자 사칭이나 뒷방 관리는 금지."

#. Tower/Content/UI/Chat/ChatRules.uexp
msgctxt "::49B2CC7E42EF66EB22F625B055725559"
msgid "No sexually explicit behavior."
msgstr "성적으로 노골적인 행위 금지."

#. Tower/Content/UI/Chat/ChatRules.uexp
msgctxt "::FD596F104CC01D4F637D4D9E385B9337"
msgid "No encouragement of violence or self-harm towards others."
msgstr "타인에 대한 폭력이나 자해를 부추기는 행위 금지."

#. Tower/Content/UI/Chat/ChatRules.uexp
msgctxt "::0D3F3FE747E6F7A30C4CEF9739EC90BB"
